flowchart LR
    subgraph SIGNALS["Signals"]
        S1["ModelSignalA<br/>Text"]
        S2["ModelSignalB<br/>Value"]
        S3["ModelSignalC<br/>Enabled"]
    end

    subgraph SENDER["MultiChannelSender (MonoBehaviour)"]
        SND["Send(channel, signal)"]
        FLUSH["FlushAll()"]
    end

    subgraph CHANNELS["ModelChannel (ScriptableObject)"]
        CHA["Channel A"]
        CHB["Channel B"]
        CHC["Channel C"]
        CHX["Channel X"]
    end

    subgraph CONTEXT["ModelSignalContext"]
        FULL["Full Context<br/>Channel -> Signal[]"]
    end

    subgraph DETECTORS["ModelDetector (ScriptableObject)"]
        DAC["dAC<br/>subscribes: A, C"]
        DB["dB<br/>subscribes: B"]
        DETX["detectorX<br/>subscribes: X"]
    end

    subgraph OUTPUT["Serialized Output"]
        DUMP["context-dump.json"]
    end

    S1 -->|"send to A"| SND
    S2 -->|"send to B"| SND
    S3 -->|"send to C"| SND

    SND -->|"publish"| CHA
    SND -->|"publish"| CHB
    SND -->|"publish"| CHC
    SND -->|"publish"| CHX

    CHA --> FLUSH
    CHB --> FLUSH
    CHC --> FLUSH
    CHX --> FLUSH

    FLUSH --> FULL

    FULL -->|"Receive(fullContext)"| DAC
    FULL -->|"Receive(fullContext)"| DB
    FULL -->|"Receive(fullContext)"| DETX

    DAC -->|"LastContext: A/C"| DUMP
    DB -->|"LastContext: B"| DUMP
    DETX -->|"LastContext: X"| DUMP
